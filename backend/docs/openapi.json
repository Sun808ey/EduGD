{
  "openapi": "3.1.0",
  "info": {
    "title": "EduG School Policy API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "administratorBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "deviceCredential": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "DeviceCredential followed by the enrolled credential UUID. Requests also carry X-Device-Timestamp, X-Device-Nonce, X-Device-Body-SHA256 and X-Device-Signature."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Pagination": {
        "type": "object",
        "required": [
          "page",
          "per_page",
          "total",
          "has_next"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "has_next": {
            "type": "boolean"
          }
        }
      },
      "PolicyV3Payload": {
        "type": "object",
        "required": [
          "schema_version",
          "timezone",
          "refresh_after_seconds",
          "default_mode",
          "emergency_packages",
          "required_capabilities",
          "minimum_dpc_version",
          "modes",
          "schedules",
          "screen_time",
          "web_filter",
          "network_controls",
          "telephony_controls"
        ],
        "properties": {
          "schema_version": {"type": "integer", "const": 3},
          "timezone": {"type": "string", "const": "Africa/Kampala"},
          "web_filter": {
            "type": "object",
            "required": ["default_action", "rules"],
            "properties": {
              "default_action": {"type": "string", "enum": ["allow", "block"]},
              "rules": {"type": "array"}
            },
            "additionalProperties": false
          },
          "network_controls": {
            "type": "object",
            "required": ["wifi_only", "disallow_mobile_network_configuration", "disallow_tethering", "disallow_user_vpn", "always_on_filtering_vpn", "vpn_lockdown_required"],
            "additionalProperties": {"type": "boolean"}
          },
          "telephony_controls": {
            "type": "object",
            "required": ["disallow_outgoing_calls", "disallow_sms", "preserve_emergency_calls"],
            "additionalProperties": {"type": "boolean"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "security": [
    {
      "administratorBearer": []
    }
  ],
  "paths": {
    "/admin/auth/login": {
      "post": {
        "security": [],
        "responses": {
          "200": {
            "description": "Administrator login succeeded"
          },
          "400": {
            "description": "API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/auth/logout": {
      "post": {
        "responses": {
          "200": {
            "description": "Administrator session revoked"
          },
          "401": {
            "description": "API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }

# Leave blank to use the local Vite proxy to http://127.0.0.1:5000.
VITE_API_BASE_URL=
VITE_API_TIMEOUT=30000
# Optional public browser ingest DSN and release identifier.
VITE_SENTRY_DSN=
VITE_APP_RELEASE=
# Public, non-secret values used to construct the Android setup-wizard QR payload.
VITE_DPC_APK_DOWNLOAD_URL=
VITE_DPC_ADMIN_COMPONENT=io.github.sun808ey.edugd.dpc/io.github.sun808ey.edugd.dpc.admin.AdminReceiver
VITE_DPC_SIGNATURE_CHECKSUM=
VITE_DPC_MIN_VERSION_CODE=1

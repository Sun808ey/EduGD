{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "buildCommand": "pip install --requirement requirements.txt"
  },
  "deploy": {
    "preDeployCommand": ["python -m scripts.verify_hosted_environment"],
    "startCommand": "gunicorn --config app/gunicorn_config.py app.wsgi:app",
    "healthcheckPath": "/api/v1/ready",
    "healthcheckTimeout": 120,
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
